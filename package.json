{
  "name": "xijian-health",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "admin:local": "node scripts/create-admin.mjs",
    "test": "node --experimental-strip-types --test tests/workflow.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "db:local": "wrangler d1 migrations apply xijian-db --local",
    "db:remote": "wrangler d1 migrations apply xijian-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.12",
    "@cloudflare/workers-types": "^4.20260620.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.40.0",
    "miniflare": "4.20260617.1"
  }
}
